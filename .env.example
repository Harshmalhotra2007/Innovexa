# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================
# Get these from your Neon dashboard at https://neon.tech
# Use the "pooled connection" string for DATABASE_URL
# Use the "direct connection" string for DIRECT_URL
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ============================================
# BOT SERVICE CONFIGURATION (OPTIONAL)
# ============================================
# URL for the Render bot service
MEET_BOT_URL="https://innovexa-meet-bot.onrender.com"
BOT_SERVICE_URL="https://innovexa-meet-bot.onrender.com"

# Bot identifier name
BOT_NAME="Innovexa Notetaker"

# MeetingBaas API key (fallback if not provided in request)
MEETINGBAAS_API_KEY="your-meetingbaas-api-key"

# ============================================
# STORAGE CONFIGURATION (OPTIONAL)
# ============================================
# AWS S3
S3_BUCKET="your-bucket-name"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"

# Supabase Storage
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"

# ============================================
# LIVEKIT CONFIGURATION (OPTIONAL)
# ============================================
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"

# ============================================
# AI SERVICES CONFIGURATION (OPTIONAL)
# ============================================
# OpenAI Whisper Transcription API
OPENAI_API_KEY="your-openai-api-key"

# ChromaDB Vector Search
CHROMADB_URL="http://localhost:8000"

# Kafka (for Oracle Core pipeline)
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"

# ============================================
# EMAIL CONFIGURATION (OPTIONAL)
# ============================================
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="notifications@innovexa.com"

# ============================================
# WEBHOOKS & APPLICATION (OPTIONAL)
# ============================================
N8N_WEBHOOK_SECRET="your-n8n-webhook-secret"
NEXT_PUBLIC_APP_URL="https://innovexa-innovexapu.vercel.app"

