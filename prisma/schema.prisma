generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  Member
  Admin
  Organizer
}

enum TaskStatus {
  Pending
  In_Progress
  Completed
  Overdue
  Escalated
}

enum TaskPriority {
  Low
  Medium
  High
  Critical
}

/// Represents an organizational division or department within Innovexa.
model Department {
  id           String   @id @default(uuid())
  name         String   @unique
  code         String   @unique
  managerName  String
  managerEmail String
  users        User[]
  createdAt    DateTime @default(now())
}

/// Represents an employee/user registered in the Innovexa console.
model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  role         Role        @default(Member)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  tasks        Task[]
  createdAt    DateTime    @default(now())
}

/// Represents a scheduled or processed meeting in the Innovexa console.
model Meeting {
  id           String           @id @default(uuid())
  title        String
  date         DateTime
  durationMins Int              @default(45)
  department   String?
  agenda       String?
  objectives   String?
  transcript   String?
  status       String           @default("Processed")
  segments     MeetingSegment[]
  decisions    Decision[]
  tasks        Task[]
  recordings   Recording[]
  aiAgent      AIAgent?
  actionItems  ActionItem[]
  citations    Citation[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([date])
  @@index([department])
}

/// Represents an individual chat/diarized speech segment from a meeting transcript.
model MeetingSegment {
  id        String   @id @default(uuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  speaker   String
  timestamp String
  text      String
  type      String   @default("discussion")
  order     Int
}

/// Represents a formal decision derived from a meeting transcript.
model Decision {
  id          String        @id @default(uuid())
  meetingId   String
  meeting     Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title       String
  context     String
  rationale   String?
  department  String
  tags        String[]      @default([])
  clusterId   String?
  cluster     TopicCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  decisions1  Contradiction[] @relation("Dec1")
  decisions2  Contradiction[] @relation("Dec2")
}

/// Represents an action item or task generated from a meeting transcript.
model Task {
  id              String         @id @default(uuid())
  meetingId       String?
  meeting         Meeting?       @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  ownerName       String
  ownerEmail      String?
  assigneeId      String?
  assignee        User?          @relation(fields: [assigneeId], references: [id])
  department      String
  priority        TaskPriority   @default(Medium)
  status          TaskStatus     @default(Pending)
  deadline        DateTime
  escalationLevel Int            @default(0)
  escalatedAt     DateTime?
  escalatedTo     String?
  notifications   Notification[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([department])
  @@index([deadline])
  @@index([meetingId])
  @@index([status, department])
  @@index([assigneeId, deadline])
}

/// Represents an alert/notification triggered by task SLA breaches or assignments.
model Notification {
  id        String   @id @default(uuid())
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  recipient String
  subject   String
  body      String
  type      String
  sentAt    DateTime @default(now())
  read      Boolean  @default(false)
}

/// Represents a voice recording file linked to a meeting.
model Recording {
  id          String   @id @default(uuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  url         String   // S3/Supabase Storage URL
  duration    Int      // Duration in seconds
  size        Int      // File size in bytes
  format      String   // e.g., "audio/mp3"
  uploadedAt  DateTime @default(now())
  transcript  Json?    // Optional: Store transcript as JSON

  @@index([meetingId])
}

/// Represents an autonomous AI Agent associated with a meeting.
model AIAgent {
  id           String    @id @default(uuid())
  meetingId    String    @unique
  meeting      Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  status       String    @default("idle") // "idle", "joining", "recording", "transcribing", "summarizing", "completed"
  joinedAt     DateTime?
  recordingUrl String?
  transcript   Json?     // [{ "speaker": "Alice", "text": "Hello", "timestamp": "00:00:01" }]
  summary      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([meetingId])
}

/// Represents a production-grade action item extracted from an AI Agent transcript.
model ActionItem {
  id        String    @id @default(uuid())
  meetingId String
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee  String
  task      String
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  @@index([meetingId])
}

/// Represents a topic cluster computed by HDBSCAN on decision embeddings.
model TopicCluster {
  id        String     @id @default(uuid())
  keywords  String[]   @default([])
  decisions Decision[]
  createdAt DateTime   @default(now())
}

/// Represents a detected contradiction between two decisions.
model Contradiction {
  id          String   @id @default(uuid())
  decision1Id String
  decision1   Decision @relation("Dec1", fields: [decision1Id], references: [id], onDelete: Cascade)
  decision2Id String
  decision2   Decision @relation("Dec2", fields: [decision2Id], references: [id], onDelete: Cascade)
  confidence  Float
  createdAt   DateTime @default(now())
}

/// Represents a citation trail mapping a summary block to a transcript chunk.
model Citation {
  id                String   @id @default(uuid())
  meetingId         String
  meeting           Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  transcriptChunkId String
  confidence        Float
  createdAt         DateTime @default(now())
}


