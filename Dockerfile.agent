# Multi-stage Dockerfile for AI Agent Service with Playwright, Node, and FFmpeg
FROM mcr.microsoft.com/playwright/node:v1.44.0-jammy AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies for audio processing & Python
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    xvfb \
    pulseaudio \
    pulseaudio-utils \
    dbus-x11 \
    alsa-utils \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/ai-agent-service

COPY ai-agent-service/package*.json ./
RUN npm install

COPY ai-agent-service/ ./

# Install Python dependencies for diarization (optional, with fallback)
RUN pip3 install --no-cache-dir pyannote.audio torch torchaudio 2>/dev/null || echo "PyAnnote install skipped - fallback will be used"

# Create recordings directory
RUN mkdir -p /app/public/recordings

# Copy and setup entrypoint script
RUN chmod +x ./entrypoint.sh

# Expose WebSocket port
EXPOSE 8081

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD node -e "require('net').connect(8081, 'localhost').on('connect', () => process.exit(0)).on('error', () => process.exit(1))"

# Start the agent service via entrypoint script
ENTRYPOINT ["./entrypoint.sh"]