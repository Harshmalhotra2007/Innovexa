# Multi-stage Dockerfile for AI Agent Service with Playwright, Node, and FFmpeg

# Stage 1: Base dependencies
FROM node:20-bookworm-slim AS base

# Install system dependencies for Playwright, FFmpeg, and audio processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    ca-certificates \
    xvfb \
    pulseaudio \
    pulseaudio-utils \
    dbus-x11 \
    alsa-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Stage 2: Install Playwright browsers
FROM base AS playwright-deps
RUN npx playwright@latest install-deps chromium
RUN npx playwright@latest install chromium

# Stage 3: Build application
FROM playwright-deps AS builder
COPY ai-agent-service/package*.json ./ai-agent-service/
RUN cd ai-agent-service && npm ci --only=production

# Stage 4: Final runtime image
FROM playwright-deps AS runtime

# Copy built application
COPY --from=builder /app/ai-agent-service/node_modules ./ai-agent-service/node_modules
COPY ai-agent-service/ ./ai-agent-service/

# Copy Python diarization script
COPY ai-agent-service/diarize.py ./ai-agent-service/

# Install Python dependencies for diarization (optional, with fallback)
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip && \
    pip3 install --no-cache-dir pyannote.audio torch torchaudio 2>/dev/null || echo "PyAnnote install skipped - fallback will be used" && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app/ai-agent-service

# Create recordings directory
RUN mkdir -p /app/public/recordings

# Copy and setup entrypoint script
COPY ai-agent-service/entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

# Expose WebSocket port
EXPOSE 8081

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD node -e "require('net').connect(8081, 'localhost').on('connect', () => process.exit(0)).on('error', () => process.exit(1))"

# Start the agent service via entrypoint script
ENTRYPOINT ["./entrypoint.sh"]